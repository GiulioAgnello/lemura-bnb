# Copia questo file in .env.local e inserisci i valori reali

# WordPress REST API (era VITE_WP_API_URL)
NEXT_PUBLIC_WP_API_URL=https://api.lemuradegliangeli.it/wp-json/wp/v2

# CRM API (era VITE_CRM_API_URL)
NEXT_PUBLIC_CRM_API_URL=https://api.lemuradegliangeli.it/wp-json/lemura-crm/v1

# URL di prenotazione esterna (era VITE_BOOKING_URL)
NEXT_PUBLIC_BOOKING_URL=https://www.booking.com/...

# URL Airbnb (era VITE_AIRBNB_URL)
NEXT_PUBLIC_AIRBNB_URL=https://www.airbnb.it/...
