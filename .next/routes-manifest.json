{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/camere/[slug]",
      "regex": "^/camere/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/camere/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/strutture/[slug]",
      "regex": "^/strutture/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/strutture/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/contatti",
      "regex": "^/contatti(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contatti(?:/)?$"
    },
    {
      "page": "/esperienze",
      "regex": "^/esperienze(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/esperienze(?:/)?$"
    },
    {
      "page": "/galleria",
      "regex": "^/galleria(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/galleria(?:/)?$"
    },
    {
      "page": "/recensioni",
      "regex": "^/recensioni(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/recensioni(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/spa",
      "regex": "^/spa(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/spa(?:/)?$"
    },
    {
      "page": "/strutture",
      "regex": "^/strutture(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/strutture(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}